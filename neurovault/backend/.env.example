# ==========================================================================
# NeuroVault backend configuration
# Copy this file to `.env` inside backend/ and fill in your values.
# NEVER commit the real .env file.
# ==========================================================================

# --- Required for chat answers (retrieval works without it) ---------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Models ----------------------------------------------------------------
# Preserved from the original project (main.py)
GROQ_MODEL=openai/gpt-oss-120b
# HuggingFace sentence-transformers model (default of the original pipeline)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Persistence (fixed the Chroma_db / chroma_db inconsistency) ----------
# Relative paths resolve against the project root (the folder containing backend/)
CHROMA_PERSIST_DIRECTORY=chroma_db
# Must stay "langchain" to keep compatibility with the index created by
# the original createdatabase.py
COLLECTION_NAME=langchain

# --- Retrieval (preserved from main.py) ------------------------------------
SEARCH_TYPE=mmr
RETRIEVER_K=4
RETRIEVER_FETCH_K=10
RETRIEVER_LAMBDA_MULT=0.5

# --- Ingestion (preserved from createdatabase.py) --------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=.pdf,.txt,.md

# --- Paths ------------------------------------------------------------------
DOCUMENTS_DIR=document_loaders
UPLOADS_DIR=uploads

# --- HTTP -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
LLM_TIMEOUT_S=60

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
# Optional: serve a built frontend from the API process (leave unset normally)
# STATIC_DIR=../frontend/dist
